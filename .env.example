# =============================================================================
# REQUIRED — the app won't start without these.
# =============================================================================

# Supabase — create a free project at supabase.com, then copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — server-side ONLY, never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# AI model — powers the twin chat, all the Personal Intelligence generators,
# and the demo conversations. lib/anthropic.ts tries every key you set
# below IN ORDER (Gemini → Groq → OpenRouter → Mistral → Cohere) and falls
# through to the next provider on a rate limit / outage, so the app doesn't
# go down just because one free tier's daily cap got hit. You only need ONE
# of these to run the app — set more for resilience, not because they're
# required.
#
# Gemini — get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (gemini-3.6-flash). Swap to
# gemini-3.5-flash-lite for lower latency/cost, or gemini-3.1-pro-preview
# for higher quality at a much lower free daily-request cap.
# GEMINI_MODEL=gemini-3.6-flash

# Groq — free tier, very fast inference. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free-tier model IDs (suffixed ":free") route through
# multiple underlying vendors including DeepSeek, at no cost. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Mistral — free "La Plateforme" tier. Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Cohere — free trial tier, via Cohere's OpenAI-compatible endpoint.
# Get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# COHERE_MODEL=command-r-plus

# App URL — http://localhost:3000 for local dev, your full Vercel URL in prod
# (https://your-domain.com). Used in OG image absolute URLs + invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# OPTIONAL — every feature degrades gracefully if these are missing.
# =============================================================================

# Apify — for X / Twitter + Instagram profile scrapes. Sign up at apify.com,
# create a token in Settings → Integrations. Without this, the social-profile
# scrape chain skips Apify and falls through to ScrapingDog (if set) or just
# returns "no scrape available."
APIFY_TOKEN=

# ScrapingDog — second-vendor fallback for LinkedIn / X / Instagram scrapes.
# Sign up at scrapingdog.com. Used when Apify fails or for LinkedIn profiles
# specifically (where it has the best coverage).
SCRAPINGDOG_API_KEY=

# Exa — semantic web search for the "Find people" feature on /dashboard and
# the SelfDiscovery auto-bio pull in onboarding. Sign up at exa.ai.
EXA_API_KEY=

# Resend — transactional email (magic link sign-in, notifications). Without
# this, magic-link auth falls back to Supabase's built-in email sender.
# Sign up at resend.com, verify your sending domain.
RESEND_API_KEY=

# Override the default twin model. Defaults to claude-sonnet-4-6.
# TWIN_MODEL=claude-sonnet-4-6

# Giphy — twin-to-twin chat occasionally drops a contextual GIF. Sign up
# at developers.giphy.com (PG-13 rating enforced in code). Without this
# the GIF feature is silently disabled — chat still works fine.
GIPHY_API_KEY=

# Resend "from" address. Defaults to "SyncedIn <hello@syncedin.org>" but
# you should set it to your verified sending domain. Format: "Name <addr>".
# NOTIFICATION_FROM_EMAIL=SyncedIn <hello@yourdomain.com>

# HMAC secret for unsubscribe-link tokens (per RFC 8058 / Gmail Feb-2024
# List-Unsubscribe-Post). Use any long random string. Generate one with:
#   openssl rand -hex 32
NOTIFY_HMAC_SECRET=

# Weekly digest cron secret. Vercel cron sends this as `Authorization:
# Bearer <CRON_SECRET>`. Generate with `openssl rand -hex 32` and set
# the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=
